ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-too

DATABASE_URL=sqlite:///./data/app.db

MODEM_PORT=/dev/ttyUSB1
MODEM_BAUD=115200

# 外呼 Call Worker 自动启动硬开关，默认关闭；确认硬件后再开启。
CALL_WORKER_ENABLED=0
# 短信通知硬开关：默认关闭；开启后 CallWorker 空闲时发送扫描产生的短信。
SMS_ENABLED=0
WORKER_POLL_SECONDS=5

AUDIO_DEVICE=plughw:1,0

CALL_CONNECT_TIMEOUT_SECONDS=90
# 响铃后未接通释放的拒接阈值（秒）：小于该时长视为主动拒接，不自动重试。
REJECTED_END_SECONDS=20
MIN_CONNECTED_SECONDS=8
RETRY_DELAY_SECONDS=300
MAX_CALL_ATTEMPTS=2

TTS_PROVIDER=none
# 话术音频生成：none = 不生成（离线默认）；edge = Microsoft Edge 在线 TTS
# （免费、无需 API key，但需要能访问微软服务的网络；输出 MP3，播放端用
# ffplay 直接播放）。真实部署选择：
# TTS_PROVIDER=edge
TTS_API_KEY=
# edge provider 的发音人（Edge 语音名，如 zh-CN-XiaoxiaoNeural）；其他
# provider 预留。
TTS_VOICE=zh-CN-XiaoxiaoNeural

DEFAULT_TIMEZONE=Asia/Shanghai

# 备份任务默认开启：使用 SQLite backup API 打包数据库、原始导入文件和话术音频。
# WebDAV 凭据仅从环境变量读取，不会写入数据库或备份包；留空则只保留本地备份。
BACKUP_ENABLED=1
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=data/backups
BACKUP_MAX_RETRIES=2
BACKUP_WEBDAV_URL=
BACKUP_WEBDAV_USERNAME=
BACKUP_WEBDAV_PASSWORD=
